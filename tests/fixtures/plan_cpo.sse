data: {"result":{"content":[{"type":"text","text":"{\"ok\":true,\"stored\":false,\"catalog_size\":118,\"paid_variables_not_listed\":12,\"total_matched\":24,\"other_companies_left_out\":13,\"candidates\":[{\"variable\":\"v:3363.two.revenue_americas.annual\",\"name\":\"FOCI Fiber Optic (3363) annual revenue from the Americas\",\"entity\":\"3363.TWO\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"annual\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"caveat\":\"A sales region, not a customer identity and not end demand. One unnamed customer was 70.16% of 2025 sales and 71.56% of 2024 sales. Not CPO or FAU revenue.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"2025\",\"next_reading\":null,\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optic, optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:3363.two.revenue_americas.quarterly\",\"name\":\"FOCI Fiber Optic (3363) revenue from the Americas\",\"entity\":\"3363.TWO\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"caveat\":\"A sales region, not a customer identity and not end demand. One unnamed customer was 70.16% of 2025 sales. Not CPO or FAU revenue. Q3 and Q4 2025 cannot be split from the documents on disk; full years are in v:3363.two.revenue_americas.annual.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"2026-Q2\",\"next_reading\":\"2026-11-14\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optic, optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:3363.two.revenue.monthly\",\"name\":\"FOCI Fiber Optic (3363) monthly revenue\",\"entity\":\"3363.TWO\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"caveat\":\"Total company revenue, dominated by legacy lines. It does not show FAU or CPO revenue.\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optic, optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:lite.us.npo_cpo_statement.quarterly\",\"name\":\"Lumentum statements on NPO and CPO in scale-up\",\"entity\":\"LITE.US\",\"category\":\"demand\",\"chain_position\":\"network.optical_component\",\"data_type\":\"statement\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"statement\",\"source_class\":\"issuer_ir\",\"readings\":\"withheld_pending_source_rights_review\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":null,\"suggested_runner\":\"llm_draft\",\"matched_because\":[\"terms: in, optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:3363.two.capex.quarterly\",\"name\":\"FOCI Fiber Optic (3363) cash spent on property, plant and equipment\",\"entity\":\"3363.TWO\",\"category\":\"cash\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"ytd\",\"unit\":\"TWD thousand\",\"caveat\":\"All property, plant and equipment, year to date. It does not isolate the silicon photonics FAU line in the annual report's equipment plan, and prepaid equipment sits in a separate cash flow row. Not evidence of FAU or CPO shipments.\",\"proxy_for\":\"procurement\",\"ytd_warning\":\"Year to date. Thresholds need reads_ytd, and it is never compared across periods.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"2026-Q2\",\"next_reading\":\"2026-11-14\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optic, optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:6268.t.prg_orders_yoy.quarterly\",\"name\":\"Nabtesco precision reduction gear orders, change from a year earlier\",\"entity\":\"6268.T\",\"category\":\"demand\",\"chain_position\":\"robotics.reducer\",\"data_type\":\"percent\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"percent, year on year\",\"source_class\":\"issuer_ir\",\"readings\":\"withheld_pending_source_rights_review\",\"latest_period\":\"2026-Q2\",\"next_reading\":\"2026-11-13\",\"suggested_runner\":\"program\",\"matched_because\":[\"names 6268.T\"]},{\"variable\":\"v:2455.tw.revenue.monthly\",\"name\":\"Visual Photonics Epitaxy (2455) monthly revenue\",\"entity\":\"2455.TW\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:3081.two.revenue.monthly\",\"name\":\"LandMark Optoelectronics (3081) monthly revenue\",\"entity\":\"3081.TWO\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"caveat\":\"Total company revenue. The issuer ties it to data-center shipments, which is not shown to be CPO.\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:3163.two.revenue.monthly\",\"name\":\"Browave (3163) monthly revenue\",\"entity\":\"3163.TWO\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"caveat\":\"Total company revenue. The issuer does not report CPO revenue, so a rise cannot prove a CPO ramp.\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:4971.two.revenue.monthly\",\"name\":\"IntelliEPI (4971) monthly revenue\",\"entity\":\"4971.TWO\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:4977.tw.revenue.monthly\",\"name\":\"Pcl Technologies (4977) monthly revenue\",\"entity\":\"4977.TW\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:cien.us.revenue.quarterly\",\"name\":\"Ciena total revenue\",\"entity\":\"CIEN.US\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"USD million\",\"caveat\":\"Company-wide revenue, not CPO or component revenue. The universe lists Ciena at optical_component, but most revenue is Networking Platforms (1,355.7 million in FY2026-Q3). CPO is not mentioned in the release or the 10-Q text read. Two customers were 41.7% of FY2026-Q3 revenue.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2026-Q3\",\"next_reading\":\"2026-12-30\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:cohr.us.data_center_communications_revenue.quarterly\",\"name\":\"Coherent Datacenter & Communications segment revenue\",\"entity\":\"COHR.US\",\"category\":\"demand\",\"chain_position\":\"network.optical_module\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"USD million\",\"caveat\":\"A segment, not CPO revenue and not data center alone. The 10-Q describes it as transceivers, co-packaged optics, optical circuit switches and systems, with no product split, and it also holds communications sales. Part of the FY2027-Q1 growth may reflect business units moved in from Industrial; see scope_breaks.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-09\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:cohr.us.revenue.quarterly\",\"name\":\"Coherent total revenue\",\"entity\":\"COHR.US\",\"category\":\"revenue\",\"chain_position\":\"network.optical_module\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"USD million\",\"caveat\":\"Company-wide revenue, not CPO revenue: Coherent gives no CPO line, and its 10-Q does not disaggregate by product type. Includes the Industrial segment. Two divestitures cut the comparison base; the release's 56% pro forma growth for FY2027-Q1 differs from 49.9% reported and the release does not define it.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-09\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:fn.us.revenue.quarterly\",\"name\":\"Fabrinet total revenue\",\"entity\":\"FN.US\",\"category\":\"revenue\",\"chain_position\":\"network.optical_module\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"USD million\",\"caveat\":\"Company-wide contract manufacturing revenue, not CPO revenue: the release does not mention CPO. Includes automotive, industrial and others (17.2% in FY2027-Q1). Data center was 52.7% that quarter per 10-Q Note 3, on end market categories that replace the optical and non-optical split used through FY2026-Q3. Few customers carry most sales.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-03\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:lite.us.revenue.quarterly\",\"name\":\"Lumentum net revenue\",\"entity\":\"LITE.US\",\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"USD million\",\"source_class\":\"issuer_ir\",\"readings\":\"withheld_pending_source_rights_review\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-04\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:cohr.us.capex.quarterly\",\"name\":\"Coherent cash spent on property, plant and equipment\",\"entity\":\"COHR.US\",\"category\":\"cash\",\"chain_position\":\"network.optical_module\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"ytd\",\"unit\":\"USD million\",\"caveat\":\"Year to date within the fiscal year. Company-wide cash paid, not CPO capex; no product split. Capex with negative operating cash flow does not by itself prove demand. Excludes equipment still unpaid: 527.7 million in accounts payable at FY2027-Q1 end vs 71.6 million a year earlier. The drivers in MD&A were not read.\",\"proxy_for\":\"procurement\",\"ytd_warning\":\"Year to date. Thresholds need reads_ytd, and it is never compared across periods.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-09\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:cohr.us.gross_margin.quarterly\",\"name\":\"Coherent GAAP gross margin\",\"entity\":\"COHR.US\",\"category\":\"margin\",\"chain_position\":\"network.optical_module\",\"data_type\":\"percent\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"percent\",\"caveat\":\"Company-wide GAAP margin blending Datacenter & Communications with Industrial. It says nothing about the margin on CPO or on any one product. Divestitures changed the mix from FY2026-Q1.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-09\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:cohr.us.operating_cash_flow.quarterly\",\"name\":\"Coherent net cash from operating activities\",\"entity\":\"COHR.US\",\"category\":\"cash\",\"chain_position\":\"network.optical_module\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"ytd\",\"unit\":\"USD million\",\"caveat\":\"Year to date within the fiscal year: Q2 is six months, Q3 nine, Q4 the full year. A negative reading is not a demand signal on its own. In FY2027-Q1 the statement shows inventories using 737.1 million and receivables 255.3 million, partly offset by contract liabilities of 269.3 million. Management's explanation in MD&A was not read.\",\"ytd_warning\":\"Year to date. Thresholds need reads_ytd, and it is never compared across periods.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-09\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:lite.us.capex.quarterly\",\"name\":\"Lumentum cash spent on property, plant and equipment\",\"entity\":\"LITE.US\",\"category\":\"cash\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"ytd\",\"unit\":\"USD million\",\"caveat\":\"Year to date within the fiscal year. Company-wide, not CPO capex. It does not by itself prove demand. Excludes equipment still unpaid: 253.5 million at FY2027-Q1 end vs 66.6 million a year earlier. Marvell agreed on 2026-11-02 to acquire Lumentum, expected to close in 1H CY2028: record a scope break on completion.\",\"proxy_for\":\"procurement\",\"ytd_warning\":\"Year to date. Thresholds need reads_ytd, and it is never compared across periods.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-04\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:lite.us.gross_margin.quarterly\",\"name\":\"Lumentum GAAP gross margin\",\"entity\":\"LITE.US\",\"category\":\"margin\",\"chain_position\":\"network.optical_component\",\"data_type\":\"percent\",\"cadence\":\"quarterly\",\"period_basis\":\"discrete\",\"unit\":\"percent\",\"source_class\":\"issuer_ir\",\"readings\":\"withheld_pending_source_rights_review\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-04\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:lite.us.operating_cash_flow.quarterly\",\"name\":\"Lumentum net cash from operating activities\",\"entity\":\"LITE.US\",\"category\":\"cash\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"quarterly\",\"period_basis\":\"ytd\",\"unit\":\"USD million\",\"caveat\":\"Year to date within the fiscal year: Q2 is six months, Q3 nine, Q4 the full year. Company-wide, not CPO. A customer's USD 100 million capacity reservation instalment was booked in September 2026 as a receivable and contract liability, per the 10-Q. Marvell agreed on 2026-11-02 to acquire Lumentum, expected to close in 1H CY2028: record a scope break on completion.\",\"ytd_warning\":\"Year to date. Thresholds need reads_ytd, and it is never compared across periods.\",\"source_class\":\"issuer_filing\",\"latest_period\":\"FY2027-Q1\",\"next_reading\":\"2027-02-04\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical\",\"in the optical_cpo theme\"]},{\"variable\":\"v:tw.network_optical_component.revenue_sum.monthly\",\"name\":\"Taiwan network.optical_component monthly revenue, total of 5 companies\",\"entity\":null,\"category\":\"revenue\",\"chain_position\":\"network.optical_component\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"caveat\":\"Total company revenue, not CPO or optical-only revenue. It omits fiber-attach supplier Browave, and Pcl Technologies' consolidation change flows into it from 2026-07. No member reports CPO revenue.\",\"aggregate\":true,\"aggregate_warning\":\"A total of 5 variables. It moves with its largest member, so it can mislead about any one company.\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\",\"Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: optical, revenue\",\"in the optical_cpo theme\"]},{\"variable\":\"v:tw.network_switch.revenue_sum.monthly\",\"name\":\"Taiwan network.switch monthly revenue, total of 3 companies\",\"entity\":null,\"category\":\"revenue\",\"chain_position\":\"network.switch\",\"data_type\":\"amount\",\"cadence\":\"monthly\",\"period_basis\":\"discrete\",\"unit\":\"TWD thousand\",\"aggregate\":true,\"aggregate_warning\":\"A total of 3 variables. It moves with its largest member, so it can mislead about any one company.\",\"source_class\":\"exchange_open_data\",\"attribution\":[\"Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\",\"Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license\"],\"latest_period\":\"2026-09\",\"next_reading\":\"2026-11-10\",\"suggested_runner\":\"program\",\"matched_because\":[\"terms: revenue, switch\"]}],\"gaps\":[{\"kind\":\"keyword_not_in_catalog\",\"about\":\"laser\",\"detail\":\"No variable mentions this term.\"}],\"unmatched_terms\":[\"Co-packaged\"],\"selection\":{\"who\":\"Selecting variables takes care: use a stronger model or a person for this step. Routine checks afterwards can run on plain code or a low-cost model.\",\"rules\":[\"Choose only ids from candidates. Never write an id that is not listed. If nothing fits, leave the link's variables empty and describe it in variable_gap.\",\"Read every caveat first. A caveat says what this variable can't show; respect it even when the name fits.\",\"A total across companies (aggregate: true) moves with its largest member. Prefer the single companies you mean, and put the total in do_not_track if it misleads.\",\"A proxy is allowed only if the link says it is a proxy. Say what it can't show.\",\"If the catalog can't cover a claim, keep it in gaps and tell the person. Do not stretch a variable to fit.\",\"Write thresholds yourself and say they are your judgment. The catalog holds no thresholds.\"],\"why\":\"In a small synthetic trial, a low-cost and a high-cost model scored the same on tracking, while the low-cost model picked a misleading total until caveats existed.\"},\"runners\":{\"program\":{\"executor\":\"This tool. No model is needed.\",\"judgment_needed\":false,\"do\":\"Use the status as computed. A low-cost model may relay it. There is nothing here to interpret.\"},\"rules\":{\"executor\":\"Plain code, or a low-cost model applying fixed rules.\",\"judgment_needed\":false,\"do\":\"Apply the rules as written. If no rule decides, hand it to llm_draft. Do not guess.\"},\"llm_draft\":{\"executor\":\"A low-cost model drafts; a person confirms.\",\"judgment_needed\":false,\"do\":\"Extract the quote and its source only. A draft is provisional and does not count as a reading until a person confirms it.\"},\"human\":{\"executor\":\"A person.\",\"judgment_needed\":true,\"do\":\"Show the person the reading and how the harness reads it, then stop. No model decides this.\"}},\"harness_shape\":{\"hypothesis\":\"One sentence that takes a stand and could be wrong. Not a question, a label, or one reading.\",\"why\":\"The causal reasoning.\",\"tracking\":[{\"id\":\"short-id\",\"must_hold\":\"What must be true at this link.\",\"market\":\"primary or public (optional)\",\"side\":\"corroboration or risk (optional, for links off the ordered chain)\",\"variables\":[\"<id from candidates>\"],\"runner\":\"program | rules | llm_draft | human\",\"expected_by\":\"YYYY-MM-DD, or expected_note in words\",\"if_late\":\"What it would mean if this has not shown up by then.\",\"if_against\":\"What the reverse would mean.\",\"rules\":[{\"variable\":\"<id from candidates>\",\"if\":\">= N, > N, <= N, < N, or a..b (a included, b excluded)\",\"means\":\"strengthens | weakens | no_material_change | insufficient_evidence\",\"say\":\"One line.\",\"from\":\"YYYY-MM-DD (optional)\",\"until\":\"YYYY-MM-DD (optional)\"}]}],\"wrong_if\":[{\"id\":\"two-straight\",\"type\":\"consecutive\",\"label\":\"In words.\",\"variable\":\"<id>\",\"if\":\">= N\",\"count\":2},{\"id\":\"average\",\"type\":\"average\",\"label\":\"In words.\",\"variable\":\"<id>\",\"periods\":[\"2026-10\",\"2026-11\",\"2026-12\"],\"if\":\"< N\"},{\"id\":\"below-baseline\",\"type\":\"below_baseline_count\",\"label\":\"In words.\",\"baselines\":[{\"variable\":\"<id>\",\"baseline\":0}],\"min_count\":2},{\"id\":\"person\",\"type\":\"human\",\"label\":\"What only a person can read.\"}]},\"next_tool\":\"check_thesis_harness\",\"skill\":\"https://equitylayer.io/skills/thesis-harness.md\",\"boundary\":\"This reports which variable moved and which link it affects, and stops. A person owns the judgment. Nothing here says what to trade, how much, or when, and no result changes a thesis state.\"}"}],"structuredContent":{"ok":true,"stored":false,"catalog_size":118,"paid_variables_not_listed":12,"total_matched":24,"other_companies_left_out":13,"candidates":[{"variable":"v:3363.two.revenue_americas.annual","name":"FOCI Fiber Optic (3363) annual revenue from the Americas","entity":"3363.TWO","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"annual","period_basis":"discrete","unit":"TWD thousand","caveat":"A sales region, not a customer identity and not end demand. One unnamed customer was 70.16% of 2025 sales and 71.56% of 2024 sales. Not CPO or FAU revenue.","source_class":"issuer_filing","latest_period":"2025","next_reading":null,"suggested_runner":"program","matched_because":["terms: optic, optical, revenue","in the optical_cpo theme"]},{"variable":"v:3363.two.revenue_americas.quarterly","name":"FOCI Fiber Optic (3363) revenue from the Americas","entity":"3363.TWO","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"quarterly","period_basis":"discrete","unit":"TWD thousand","caveat":"A sales region, not a customer identity and not end demand. One unnamed customer was 70.16% of 2025 sales. Not CPO or FAU revenue. Q3 and Q4 2025 cannot be split from the documents on disk; full years are in v:3363.two.revenue_americas.annual.","source_class":"issuer_filing","latest_period":"2026-Q2","next_reading":"2026-11-14","suggested_runner":"program","matched_because":["terms: optic, optical, revenue","in the optical_cpo theme"]},{"variable":"v:3363.two.revenue.monthly","name":"FOCI Fiber Optic (3363) monthly revenue","entity":"3363.TWO","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","caveat":"Total company revenue, dominated by legacy lines. It does not show FAU or CPO revenue.","source_class":"exchange_open_data","attribution":["Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: optic, optical, revenue","in the optical_cpo theme"]},{"variable":"v:lite.us.npo_cpo_statement.quarterly","name":"Lumentum statements on NPO and CPO in scale-up","entity":"LITE.US","category":"demand","chain_position":"network.optical_component","data_type":"statement","cadence":"quarterly","period_basis":"discrete","unit":"statement","source_class":"issuer_ir","readings":"withheld_pending_source_rights_review","latest_period":"FY2027-Q1","next_reading":null,"suggested_runner":"llm_draft","matched_because":["terms: in, optical","in the optical_cpo theme"]},{"variable":"v:3363.two.capex.quarterly","name":"FOCI Fiber Optic (3363) cash spent on property, plant and equipment","entity":"3363.TWO","category":"cash","chain_position":"network.optical_component","data_type":"amount","cadence":"quarterly","period_basis":"ytd","unit":"TWD thousand","caveat":"All property, plant and equipment, year to date. It does not isolate the silicon photonics FAU line in the annual report's equipment plan, and prepaid equipment sits in a separate cash flow row. Not evidence of FAU or CPO shipments.","proxy_for":"procurement","ytd_warning":"Year to date. Thresholds need reads_ytd, and it is never compared across periods.","source_class":"issuer_filing","latest_period":"2026-Q2","next_reading":"2026-11-14","suggested_runner":"program","matched_because":["terms: optic, optical","in the optical_cpo theme"]},{"variable":"v:6268.t.prg_orders_yoy.quarterly","name":"Nabtesco precision reduction gear orders, change from a year earlier","entity":"6268.T","category":"demand","chain_position":"robotics.reducer","data_type":"percent","cadence":"quarterly","period_basis":"discrete","unit":"percent, year on year","source_class":"issuer_ir","readings":"withheld_pending_source_rights_review","latest_period":"2026-Q2","next_reading":"2026-11-13","suggested_runner":"program","matched_because":["names 6268.T"]},{"variable":"v:2455.tw.revenue.monthly","name":"Visual Photonics Epitaxy (2455) monthly revenue","entity":"2455.TW","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","source_class":"exchange_open_data","attribution":["Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:3081.two.revenue.monthly","name":"LandMark Optoelectronics (3081) monthly revenue","entity":"3081.TWO","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","caveat":"Total company revenue. The issuer ties it to data-center shipments, which is not shown to be CPO.","source_class":"exchange_open_data","attribution":["Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:3163.two.revenue.monthly","name":"Browave (3163) monthly revenue","entity":"3163.TWO","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","caveat":"Total company revenue. The issuer does not report CPO revenue, so a rise cannot prove a CPO ramp.","source_class":"exchange_open_data","attribution":["Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:4971.two.revenue.monthly","name":"IntelliEPI (4971) monthly revenue","entity":"4971.TWO","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","source_class":"exchange_open_data","attribution":["Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:4977.tw.revenue.monthly","name":"Pcl Technologies (4977) monthly revenue","entity":"4977.TW","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","source_class":"exchange_open_data","attribution":["Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:cien.us.revenue.quarterly","name":"Ciena total revenue","entity":"CIEN.US","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"quarterly","period_basis":"discrete","unit":"USD million","caveat":"Company-wide revenue, not CPO or component revenue. The universe lists Ciena at optical_component, but most revenue is Networking Platforms (1,355.7 million in FY2026-Q3). CPO is not mentioned in the release or the 10-Q text read. Two customers were 41.7% of FY2026-Q3 revenue.","source_class":"issuer_filing","latest_period":"FY2026-Q3","next_reading":"2026-12-30","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:cohr.us.data_center_communications_revenue.quarterly","name":"Coherent Datacenter & Communications segment revenue","entity":"COHR.US","category":"demand","chain_position":"network.optical_module","data_type":"amount","cadence":"quarterly","period_basis":"discrete","unit":"USD million","caveat":"A segment, not CPO revenue and not data center alone. The 10-Q describes it as transceivers, co-packaged optics, optical circuit switches and systems, with no product split, and it also holds communications sales. Part of the FY2027-Q1 growth may reflect business units moved in from Industrial; see scope_breaks.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-09","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:cohr.us.revenue.quarterly","name":"Coherent total revenue","entity":"COHR.US","category":"revenue","chain_position":"network.optical_module","data_type":"amount","cadence":"quarterly","period_basis":"discrete","unit":"USD million","caveat":"Company-wide revenue, not CPO revenue: Coherent gives no CPO line, and its 10-Q does not disaggregate by product type. Includes the Industrial segment. Two divestitures cut the comparison base; the release's 56% pro forma growth for FY2027-Q1 differs from 49.9% reported and the release does not define it.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-09","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:fn.us.revenue.quarterly","name":"Fabrinet total revenue","entity":"FN.US","category":"revenue","chain_position":"network.optical_module","data_type":"amount","cadence":"quarterly","period_basis":"discrete","unit":"USD million","caveat":"Company-wide contract manufacturing revenue, not CPO revenue: the release does not mention CPO. Includes automotive, industrial and others (17.2% in FY2027-Q1). Data center was 52.7% that quarter per 10-Q Note 3, on end market categories that replace the optical and non-optical split used through FY2026-Q3. Few customers carry most sales.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-03","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:lite.us.revenue.quarterly","name":"Lumentum net revenue","entity":"LITE.US","category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"quarterly","period_basis":"discrete","unit":"USD million","source_class":"issuer_ir","readings":"withheld_pending_source_rights_review","latest_period":"FY2027-Q1","next_reading":"2027-02-04","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:cohr.us.capex.quarterly","name":"Coherent cash spent on property, plant and equipment","entity":"COHR.US","category":"cash","chain_position":"network.optical_module","data_type":"amount","cadence":"quarterly","period_basis":"ytd","unit":"USD million","caveat":"Year to date within the fiscal year. Company-wide cash paid, not CPO capex; no product split. Capex with negative operating cash flow does not by itself prove demand. Excludes equipment still unpaid: 527.7 million in accounts payable at FY2027-Q1 end vs 71.6 million a year earlier. The drivers in MD&A were not read.","proxy_for":"procurement","ytd_warning":"Year to date. Thresholds need reads_ytd, and it is never compared across periods.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-09","suggested_runner":"program","matched_because":["terms: optical","in the optical_cpo theme"]},{"variable":"v:cohr.us.gross_margin.quarterly","name":"Coherent GAAP gross margin","entity":"COHR.US","category":"margin","chain_position":"network.optical_module","data_type":"percent","cadence":"quarterly","period_basis":"discrete","unit":"percent","caveat":"Company-wide GAAP margin blending Datacenter & Communications with Industrial. It says nothing about the margin on CPO or on any one product. Divestitures changed the mix from FY2026-Q1.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-09","suggested_runner":"program","matched_because":["terms: optical","in the optical_cpo theme"]},{"variable":"v:cohr.us.operating_cash_flow.quarterly","name":"Coherent net cash from operating activities","entity":"COHR.US","category":"cash","chain_position":"network.optical_module","data_type":"amount","cadence":"quarterly","period_basis":"ytd","unit":"USD million","caveat":"Year to date within the fiscal year: Q2 is six months, Q3 nine, Q4 the full year. A negative reading is not a demand signal on its own. In FY2027-Q1 the statement shows inventories using 737.1 million and receivables 255.3 million, partly offset by contract liabilities of 269.3 million. Management's explanation in MD&A was not read.","ytd_warning":"Year to date. Thresholds need reads_ytd, and it is never compared across periods.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-09","suggested_runner":"program","matched_because":["terms: optical","in the optical_cpo theme"]},{"variable":"v:lite.us.capex.quarterly","name":"Lumentum cash spent on property, plant and equipment","entity":"LITE.US","category":"cash","chain_position":"network.optical_component","data_type":"amount","cadence":"quarterly","period_basis":"ytd","unit":"USD million","caveat":"Year to date within the fiscal year. Company-wide, not CPO capex. It does not by itself prove demand. Excludes equipment still unpaid: 253.5 million at FY2027-Q1 end vs 66.6 million a year earlier. Marvell agreed on 2026-11-02 to acquire Lumentum, expected to close in 1H CY2028: record a scope break on completion.","proxy_for":"procurement","ytd_warning":"Year to date. Thresholds need reads_ytd, and it is never compared across periods.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-04","suggested_runner":"program","matched_because":["terms: optical","in the optical_cpo theme"]},{"variable":"v:lite.us.gross_margin.quarterly","name":"Lumentum GAAP gross margin","entity":"LITE.US","category":"margin","chain_position":"network.optical_component","data_type":"percent","cadence":"quarterly","period_basis":"discrete","unit":"percent","source_class":"issuer_ir","readings":"withheld_pending_source_rights_review","latest_period":"FY2027-Q1","next_reading":"2027-02-04","suggested_runner":"program","matched_because":["terms: optical","in the optical_cpo theme"]},{"variable":"v:lite.us.operating_cash_flow.quarterly","name":"Lumentum net cash from operating activities","entity":"LITE.US","category":"cash","chain_position":"network.optical_component","data_type":"amount","cadence":"quarterly","period_basis":"ytd","unit":"USD million","caveat":"Year to date within the fiscal year: Q2 is six months, Q3 nine, Q4 the full year. Company-wide, not CPO. A customer's USD 100 million capacity reservation instalment was booked in September 2026 as a receivable and contract liability, per the 10-Q. Marvell agreed on 2026-11-02 to acquire Lumentum, expected to close in 1H CY2028: record a scope break on completion.","ytd_warning":"Year to date. Thresholds need reads_ytd, and it is never compared across periods.","source_class":"issuer_filing","latest_period":"FY2027-Q1","next_reading":"2027-02-04","suggested_runner":"program","matched_because":["terms: optical","in the optical_cpo theme"]},{"variable":"v:tw.network_optical_component.revenue_sum.monthly","name":"Taiwan network.optical_component monthly revenue, total of 5 companies","entity":null,"category":"revenue","chain_position":"network.optical_component","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","caveat":"Total company revenue, not CPO or optical-only revenue. It omits fiber-attach supplier Browave, and Pcl Technologies' consolidation change flows into it from 2026-07. No member reports CPO revenue.","aggregate":true,"aggregate_warning":"A total of 5 variables. It moves with its largest member, so it can mislead about any one company.","source_class":"exchange_open_data","attribution":["Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license","Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: optical, revenue","in the optical_cpo theme"]},{"variable":"v:tw.network_switch.revenue_sum.monthly","name":"Taiwan network.switch monthly revenue, total of 3 companies","entity":null,"category":"revenue","chain_position":"network.switch","data_type":"amount","cadence":"monthly","period_basis":"discrete","unit":"TWD thousand","aggregate":true,"aggregate_warning":"A total of 3 variables. It moves with its largest member, so it can mislead about any one company.","source_class":"exchange_open_data","attribution":["Taiwan Stock Exchange (臺灣證券交易所) 2026 上市公司每月營業收入彙總表, dataset t187ap05_L, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license","Taipei Exchange (證券櫃檯買賣中心) 2026 上櫃公司每月營業收入彙總表, dataset mopsfin_t187ap05_O, as published. The Open Data is made available to the public under the Open Government Data License. Open Government Data License: https://data.gov.tw/license"],"latest_period":"2026-09","next_reading":"2026-11-10","suggested_runner":"program","matched_because":["terms: revenue, switch"]}],"gaps":[{"kind":"keyword_not_in_catalog","about":"laser","detail":"No variable mentions this term."}],"unmatched_terms":["Co-packaged"],"selection":{"who":"Selecting variables takes care: use a stronger model or a person for this step. Routine checks afterwards can run on plain code or a low-cost model.","rules":["Choose only ids from candidates. Never write an id that is not listed. If nothing fits, leave the link's variables empty and describe it in variable_gap.","Read every caveat first. A caveat says what this variable can't show; respect it even when the name fits.","A total across companies (aggregate: true) moves with its largest member. Prefer the single companies you mean, and put the total in do_not_track if it misleads.","A proxy is allowed only if the link says it is a proxy. Say what it can't show.","If the catalog can't cover a claim, keep it in gaps and tell the person. Do not stretch a variable to fit.","Write thresholds yourself and say they are your judgment. The catalog holds no thresholds."],"why":"In a small synthetic trial, a low-cost and a high-cost model scored the same on tracking, while the low-cost model picked a misleading total until caveats existed."},"runners":{"program":{"executor":"This tool. No model is needed.","judgment_needed":false,"do":"Use the status as computed. A low-cost model may relay it. There is nothing here to interpret."},"rules":{"executor":"Plain code, or a low-cost model applying fixed rules.","judgment_needed":false,"do":"Apply the rules as written. If no rule decides, hand it to llm_draft. Do not guess."},"llm_draft":{"executor":"A low-cost model drafts; a person confirms.","judgment_needed":false,"do":"Extract the quote and its source only. A draft is provisional and does not count as a reading until a person confirms it."},"human":{"executor":"A person.","judgment_needed":true,"do":"Show the person the reading and how the harness reads it, then stop. No model decides this."}},"harness_shape":{"hypothesis":"One sentence that takes a stand and could be wrong. Not a question, a label, or one reading.","why":"The causal reasoning.","tracking":[{"id":"short-id","must_hold":"What must be true at this link.","market":"primary or public (optional)","side":"corroboration or risk (optional, for links off the ordered chain)","variables":["<id from candidates>"],"runner":"program | rules | llm_draft | human","expected_by":"YYYY-MM-DD, or expected_note in words","if_late":"What it would mean if this has not shown up by then.","if_against":"What the reverse would mean.","rules":[{"variable":"<id from candidates>","if":">= N, > N, <= N, < N, or a..b (a included, b excluded)","means":"strengthens | weakens | no_material_change | insufficient_evidence","say":"One line.","from":"YYYY-MM-DD (optional)","until":"YYYY-MM-DD (optional)"}]}],"wrong_if":[{"id":"two-straight","type":"consecutive","label":"In words.","variable":"<id>","if":">= N","count":2},{"id":"average","type":"average","label":"In words.","variable":"<id>","periods":["2026-10","2026-11","2026-12"],"if":"< N"},{"id":"below-baseline","type":"below_baseline_count","label":"In words.","baselines":[{"variable":"<id>","baseline":0}],"min_count":2},{"id":"person","type":"human","label":"What only a person can read."}]},"next_tool":"check_thesis_harness","skill":"https://equitylayer.io/skills/thesis-harness.md","boundary":"This reports which variable moved and which link it affects, and stops. A person owns the judgment. Nothing here says what to trade, how much, or when, and no result changes a thesis state."}},"jsonrpc":"2.0","id":1}

