earch conclusion.\"},\"inferences\":{\"items\":[{\"id\":\"2383-tw-2026-09-revenue-readthrough\",\"symbol\":\"2383.TW\",\"company_name\":\"台光電\",\"statement\":\"台光電 increased reported revenue versus 2026-08 (+6.9% month-over-month; +168.9% year-over-year). This supports a narrow operating-momentum read-through for the issuer only.\",\"confidence\":\"low\",\"based_on\":[\"Official reported revenue for 2026-09\",\"Deterministic comparison against 2026-08\",\"Current month-over-month and year-over-year fields in the snapshot\"],\"limitation\":\"The observation does not establish end-market demand, shipment volume, margin, valuation, or an investment recommendation.\"},{\"id\":\"3037-tw-2026-09-revenue-readthrough\",\"symbol\":\"3037.TW\",\"company_name\":\"欣興\",\"statement\":\"欣興 increased reported revenue versus 2026-08 (+5.1% month-over-month; +64.7% year-over-year). This supports a narrow operating-momentum read-through for the issuer only.\",\"confidence\":\"low\",\"based_on\":[\"Official reported revenue for 2026-09\",\"Deterministic comparison against 2026-08\",\"Current month-over-month and year-over-year fields in the snapshot\"],\"limitation\":\"The observation does not establish end-market demand, shipment volume, margin, valuation, or an investment recommendation.\"},{\"id\":\"8046-tw-2026-09-revenue-readthrough\",\"symbol\":\"8046.TW\",\"company_name\":\"南電\",\"statement\":\"南電 increased reported revenue versus 2026-08 (+4.4% month-over-month; +57.8% year-over-year). This supports a narrow operating-momentum read-through for the issuer only.\",\"confidence\":\"low\",\"based_on\":[\"Official reported revenue for 2026-09\",\"Deterministic comparison against 2026-08\",\"Current month-over-month and year-over-year fields in the snapshot\"],\"limitation\":\"The observation does not establish end-market demand, shipment volume, margin, valuation, or an investment recommendation.\"}],\"scope_note\":\"These are deliberately narrow operating read-throughs derived fro