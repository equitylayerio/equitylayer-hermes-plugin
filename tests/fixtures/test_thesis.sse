data: {"result":{"content":[{"type":"text","text":"{\"ok\":true,\"result_type\":\"thesis_test\",\"schema_version\":\"1.1\",\"engine_version\":\"0.2.0\",\"thesis_id\":\"el-ai-compute-tw-materials-continuation\",\"thesis_version\":\"el-ai-compute-tw-materials-continuation:2026-08-13\",\"skill_stack_id\":\"ai_compute\",\"skill_stack_version\":\"0.1.0\",\"evaluated_at\":\"2026-11-06T07:35:13.461Z\",\"as_of\":\"2026-09\",\"fresh_until\":\"2026-11-10\",\"persistence\":\"none\",\"contract_status\":\"INITIAL_SNAPSHOT\",\"thesis_input_hash\":\"98413efe24e11d0b3c3deefc87a80db83869e0531afc3087a55b0a9bd431348e\",\"thesis\":{\"theme_id\":\"ai_compute\",\"subject\":{\"kind\":\"value_chain\",\"identifiers\":[\"2383.TW\",\"3037.TW\",\"8046.TW\"]},\"statement\":\"The July revenue data for EquityLayer's tracked Taiwan AI-materials slice does not show broad near-term deterioration relative to June.\",\"horizon\":\"next_disclosure\",\"assumptions\":[{\"assumption_id\":\"emc-july-revenue-floor\",\"statement\":\"EMC July revenue remains at or above NT$17.7B.\",\"falsifier\":\"Official July revenue is below NT$16.74B.\",\"importance\":\"core\",\"expected_by\":\"2026-08-10\"},{\"assumption_id\":\"pcb-july-breadth\",\"statement\":\"Nan Ya PCB and Unimicron each remain at or above -3% month over month in July.\",\"falsifier\":\"Both companies report July revenue below -3% month over month.\",\"importance\":\"core\",\"expected_by\":\"2026-08-10\"}]},\"portable_research_card\":null,\"evidence_boundary\":{\"pack_versions\":[{\"pack_id\":\"tw-monthly-revenue\",\"version\":\"taiwan-monthly-revenue:2026-09\",\"snapshot_hash\":\"64dea69a5c27579cda94295dda593f5871bc9e96373f24526039efc1b9c9748e\",\"as_of\":\"2026-09\",\"fresh_until\":\"2026-11-10\"}],\"limits\":[\"This result covers three Taiwan issuers only.\",\"Monthly revenue does not establish AI demand, orders, shipments, margin, valuation, or causality.\",\"No United States, Japan, or South Korea evidence is used in this version.\"]},\"markets_